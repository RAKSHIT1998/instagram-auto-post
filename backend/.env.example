NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/social_ai
# Alias accepted by backend
MONGO_URI=mongodb://127.0.0.1:27017/social_ai

REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=supersecret
ADMIN_EMAIL=admin@yourapp.com

# process roles
RUN_EMBEDDED_WORKER=true
RUN_SCHEDULER=true
RUN_ANALYTICS_CRON=true

# Hugging Face / free model gateway
HF_API_KEY=hf_xxx
HF_TEXT_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HF_FALLBACK_TEXT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Meta Graph API (Instagram + Facebook)
META_API_VERSION=v22.0
IG_USER_ID=
IG_ACCESS_TOKEN=
FB_PAGE_ID=
FB_ACCESS_TOKEN=
# Alias accepted by backend
META_ACCESS_TOKEN=

# X API
X_API_BASE=https://api.x.com/2
X_BEARER_TOKEN=
# Alias accepted by backend
TWITTER_TOKEN=

# LinkedIn API
LINKEDIN_API_BASE=https://api.linkedin.com/v2
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:xxxxxxxx
# Alias accepted by backend
LINKEDIN_TOKEN=
LINKEDIN_URN=urn:li:person:xxxxxxxx

# Payments
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional helpers
ML_SERVICE_URL=http://127.0.0.1:8000
